{
  "name": "llmhub-plugin-plugin-studio",
  "version": "1.0.0",
  "description": "Write LLMHub plugins in VS Code, with the Continue agent using this gateway's models.",
  "type": "module",
  "main": "index.mjs",
  "files": [
    "index.mjs",
    "lib",
    "ui",
    "README.md"
  ],
  "keywords": [
    "llmhub-plugin",
    "llmhub",
    "vscode",
    "continue",
    "agent",
    "developer-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huangdihd/LLMHub.git",
    "directory": "plugins/plugin-studio"
  },
  "homepage": "https://github.com/huangdihd/LLMHub/tree/main/plugins/plugin-studio",
  "engines": {
    "llmhub": "^1.4.0"
  },
  "llmhub": {
    "id": "plugin-studio",
    "name": "Plugin Studio",
    "configSchema": [
      {
        "key": "apiKey",
        "label": "LLMHub API key for the Continue agent",
        "type": "secret"
      },
      {
        "key": "model",
        "label": "Model listed first in Continue (provider/model)",
        "type": "text",
        "default": ""
      },
      {
        "key": "assistant",
        "label": "Install and configure the Continue agent",
        "type": "boolean",
        "default": true
      },
      {
        "key": "gatewayUrl",
        "label": "OpenAI-compatible base URL (empty: this gateway)",
        "type": "text",
        "default": ""
      },
      {
        "key": "workspace",
        "label": "Plugin folder (empty: .data/plugins)",
        "type": "text",
        "default": ""
      },
      {
        "key": "vscodeCommand",
        "label": "VS Code server command (empty: find openvscode-server, code-server or code)",
        "type": "text",
        "default": ""
      },
      {
        "key": "vscodeHost",
        "label": "VS Code server address",
        "type": "text",
        "default": "127.0.0.1"
      },
      {
        "key": "vscodePort",
        "label": "VS Code server port",
        "type": "number",
        "default": 3100
      },
      {
        "key": "vscodePublicUrl",
        "label": "VS Code public HTTPS URL (behind your reverse proxy)",
        "type": "text",
        "default": ""
      }
    ],
    "contributes": {
      "panels": [
        {
          "id": "studio",
          "title": "Plugin Studio",
          "location": "page",
          "page": "ui/studio.html"
        }
      ],
      "navigation": [
        {
          "panel": "studio",
          "label": "Studio",
          "icon": "i-heroicons-code-bracket-square"
        }
      ]
    }
  }
}
